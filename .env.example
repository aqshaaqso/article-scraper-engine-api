HTTP_TIMEOUT_SECONDS=15
MAX_HTML_BYTES=5242880
MAX_REDIRECTS=3
MIN_WORD_COUNT=80
SCRAPER_USER_AGENT=ArticleScraperLab/0.1
ALLOW_HTTP=false
RESPECT_ROBOTS=true
ROBOTS_FAIL_CLOSED=true
ALLOWED_DOMAINS=detik.com,tempo.co,tribunnews.com,kompas.com,antaranews.com,cnnindonesia.com,cnbcindonesia.com,liputan6.com,republika.co.id,mediaindonesia.com,metrotvnews.com,tvonenews.com
WORKER_COUNT=3
# API key SerpAPI untuk pencarian berita (berbeda dari SCRAPER_API_KEY)
SERPAPI_API_KEY=
DOMAIN_DELAY_SECONDS=1.0
# FastAPI middleware dan Go worker hanya mendukung PostgreSQL.
DATABASE_URL=
SYNC_SCRAPE_TIMEOUT_SECONDS=30
LEASE_SECONDS=600
POLL_INTERVAL_SECONDS=1
MAX_ATTEMPTS=3
REQUIRE_API_KEY=false
SCRAPER_API_KEY=
